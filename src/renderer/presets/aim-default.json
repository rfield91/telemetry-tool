{
  "version": 1,
  "id": "aim-default",
  "name": "AiM Race",
  "description": "Speed, throttle, temps/pressures, track map, and g-meter for AiM CSVs.",
  "csvFormat": "aim",
  "defaultForFormat": true,
  "overlays": [
    {
      "type": "gauge",
      "valueColumn": "GPS Speed",
      "label": "SPEED",
      "unit": "mph",
      "min": 0,
      "max": 160,
      "accent": "#2dd4bf",
      "x": 0.18,
      "y": 0.78,
      "size": 0.42
    },
    {
      "type": "bar",
      "valueColumn": "ECU TPS",
      "label": "TPS",
      "min": 0,
      "max": 100,
      "accent": "#22c55e",
      "x": 0.34,
      "y": 0.78,
      "size": 0.32
    },
    {
      "type": "key-value",
      "label": "ENGINE",
      "accent": "#fbbf24",
      "stack": "vertical",
      "x": 0.5,
      "y": 0.82,
      "size": 0.26,
      "entries": [
        {
          "valueColumn": "ECU OIL T",
          "label": "OIL T",
          "unit": "°F",
          "accent": "#fbbf24"
        },
        {
          "valueColumn": "ECU OIL P",
          "label": "OIL P",
          "unit": "bar",
          "accent": "#38bdf8"
        },
        {
          "valueColumn": "ECU ECT",
          "label": "ECT",
          "unit": "°F",
          "accent": "#fb7185"
        }
      ]
    },
    {
      "type": "track-map",
      "latitudeColumn": "GPS Latitude",
      "longitudeColumn": "GPS Longitude",
      "label": "TRACK",
      "accent": "#38bdf8",
      "x": 0.82,
      "y": 0.28,
      "size": 0.4
    },
    {
      "type": "g-meter",
      "lateralColumn": "GPS LatAcc",
      "longitudinalColumn": "GPS LonAcc",
      "label": "G",
      "maxG": 2,
      "accent": "#a78bfa",
      "x": 0.82,
      "y": 0.68,
      "size": 0.38
    }
  ]
}
